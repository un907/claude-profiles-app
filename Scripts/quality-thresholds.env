# Quality ratchet ceilings, read by `Scripts/quality-metrics.sh --check-thresholds` (CI).
# Lowered on 2026-10-07 to the 1.1.0 measurement (docs/QUALITY.md), measured with SwiftLint 0.65.1,
# lizard 1.24.1 and jscpd 5.4.0. CI fails when a value
# goes above its ceiling. When the code improves, lower the ceiling to the new value in the
# same change so it cannot regress again. Never raise a ceiling to make CI pass.

# SwiftLint warnings with .swiftlint.yml (every opt-in rule enabled, minus the rules listed
# under disabled_rules there).
MAX_SWIFTLINT_WARNINGS=701
# Functions whose cyclomatic complexity (lizard) is above 10.
MAX_FUNCTIONS_OVER_CCN_10=1
# jscpd duplicated-line percentage of Sources/, rounded to 2 decimals.
MAX_DUPLICATION_PERCENT=1.09
